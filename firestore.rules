rules_version = '2';

// Equivalente às políticas de RLS que existiam no Postgres/Supabase
// (trigger enforce_user_id()): cada usuário só lê/escreve dentro do
// próprio namespace users/{uid}/... — nunca vê dados de outro usuário.
//
// Publicar com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
